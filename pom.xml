<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>kg.medical</groupId>
	<artifactId>medical-platform</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
        <dependency> <!-- Начинает описание зависимости для работы с сущностями и репозиториями. -->
            <groupId>org.springframework.boot</groupId> <!-- Указывает группу библиотек Spring Boot. -->
            <artifactId>spring-boot-starter-data-jpa</artifactId> <!-- Подключает Spring Data JPA, Hibernate и пул подключений к базе. -->
        </dependency> <!-- Завершает описание зависимости JPA. -->
        <dependency> <!-- Начинает описание драйвера PostgreSQL. -->
            <groupId>org.postgresql</groupId> <!-- Указывает группу разработчиков драйвера PostgreSQL. -->
            <artifactId>postgresql</artifactId> <!-- Подключает драйвер для обмена данными с PostgreSQL. -->
            <scope>runtime</scope> <!-- Делает драйвер доступным при запуске приложения без прямого использования его классов в нашем коде. -->
        </dependency> <!-- Завершает описание драйвера PostgreSQL. -->
        <dependency> <!-- Начинает описание зависимости для миграций базы. -->
            <groupId>org.springframework.boot</groupId> <!-- Указывает группу библиотек Spring Boot. -->
            <artifactId>spring-boot-starter-liquibase</artifactId> <!-- Подключает Liquibase и его автоматическую настройку для Spring Boot. -->
        </dependency> <!-- Завершает описание зависимости Liquibase. -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
